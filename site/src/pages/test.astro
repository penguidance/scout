---
import { getCollection } from 'astro:content';

const all = await getCollection('software');
const blocked = all.filter(e => e.data.status === 'blocked');
---

<html>
  <body>
    <h1>{all.length} kayıt yüklendi</h1>
    <h2>{blocked.length} tanesi blocked</h2>
    <ul>
      {blocked.map(e => (
        <li>
          <strong>{e.data.id}</strong> — {e.data.notes.en}
        </li>
      ))}
    </ul>
  </body>
</html>